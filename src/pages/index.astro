---
import ApplicationForm from "../components/ApplicationForm.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import scene from "../../public/splat-viewer/scene.foundry.json";
const sceneMB = Math.ceil(
  (scene.model_bytes + scene.static_model_bytes) / 1000000,
);
---

<BaseLayout>
  <div id="top" class="page-shell">
    <SiteHeader />
    <main id="main">
      <section id="what-it-is" class="hero" aria-labelledby="hero-title">
        <div>
          <p class="section-index">Spatial capture / An ongoing experiment</p>
          <h1 id="hero-title">Real moments,<br />reconstructed in space.</h1>
        </div>
        <div class="hero-copy">
          <p>
            We use multiple cameras to make explorable records of people,
            places, and moments. Move through a scene and choose your own point
            of view.
          </p>
          <div class="hero-actions">
            <a class="text-link" href="#spatial-example">Explore a capture</a>
            <a class="text-link" href="#apply">Apply for an early session</a>
          </div>
        </div>
      </section>

      <section
        id="spatial-example"
        class="spatial-example"
        aria-labelledby="example-title"
      >
        <div class="example-heading">
          <div>
            <p class="section-index">Capture study / 01</p><h2
              id="example-title"
            >
              A moment at home
            </h2>
          </div>
          <p>
            A reconstructed room, with people in motion.<br />Load the scene to
            change your viewpoint.
          </p>
        </div>
        <div class="splat-stage" data-splat-stage>
          <div class="splat-placeholder">
            <img
              src="/site_video/opal-58e2c44c43f74117-poster.jpg"
              width="1920"
              height="1080"
              alt="Film still showing a reconstructed room and the camera viewpoints used to capture it."
              fetchpriority="high"
            />
            <div class="load-panel">
              <button
                class="button button-light"
                type="button"
                data-load-splat
                aria-describedby="download-note">Load interactive scene</button
              >
              <p id="download-note">
                About {sceneMB} MB + viewer · Loads only when selected
              </p>
            </div>
          </div>
          <noscript
            ><p class="splat-noscript">
              The viewer needs JavaScript. <a href="#capture-film"
                >Watch the capture film below</a
              >.
            </p></noscript
          >
        </div>
        <div class="scene-caption">
          <p>
            Drag to look around. Use the viewer controls for movement and
            playback.
          </p>
          <a class="text-link" href="#capture-film">Watch the film instead</a>
        </div>
        <p class="example-note">
          This experiment combines a static room reconstruction with animated
          captured subjects. It demonstrates an evolving approach to volumetric
          video. Results and playback vary by scene and device. If the viewer
          cannot run, the film below offers a recorded view.
        </p>
      </section>
      <script is:inline>
        const stage = document.querySelector("[data-splat-stage]");
        const loadButton = stage?.querySelector("[data-load-splat]");

        loadButton?.addEventListener("click", () => {
          const frame = document.createElement("iframe");
          frame.src = "/splat-viewer/index.html?v=9d0f45a-fsp";
          frame.title = "Interactive Spatial Memory with a captured moment";
          frame.allow = "fullscreen; xr-spatial-tracking";
          frame.setAttribute("allowfullscreen", "");
          stage.replaceChildren(frame);
          frame.focus();
        });
      </script>

      <section
        id="capture-film"
        class="film-section section-pad"
        aria-labelledby="film-title"
      >
        <div class="film-copy">
          <p class="section-index">Recorded view / 00:40</p>
          <h2 id="film-title">The capture film</h2>
          <p>
            A short presentation of the reconstruction. The film follows a set
            viewpoint; the interactive scene lets you move independently.
          </p>
          <a class="text-link" href="/site_video/opal-58e2c44c43f74117.mp4"
            >Open the film directly (MP4)</a
          >
        </div>
        <video
          controls
          playsinline
          preload="none"
          poster="/site_video/opal-58e2c44c43f74117-poster.jpg"
          aria-label="Forty-second capture study"
        >
          <source
            src="/site_video/opal-58e2c44c43f74117.mp4"
            type="video/mp4"
          />
          <a href="/site_video/opal-58e2c44c43f74117.mp4"
            >Watch the capture film</a
          >.
        </video>
      </section>

      <section
        id="how-it-works"
        class="process section-pad"
        aria-labelledby="process-title"
      >
        <div class="process-heading">
          <p class="section-index">Method</p>
          <h2 id="process-title">Many views of<br />the same scene.</h2>
          <p>
            Each camera records part of what happened. We combine those views
            into a reconstruction you can explore.
          </p>
        </div>
        <div>
          <ol class="steps">
            <li>
              <span>01</span><div>
                <h3>Arrange the cameras</h3><p>
                  We plan camera positions around the people, space, and
                  movement involved.
                </p>
              </div>
            </li>
            <li>
              <span>02</span><div>
                <h3>Record and reconstruct</h3><p>
                  The recordings provide the source material. Our current
                  workflow uses Gaussian splatting to reconstruct the scene from
                  those views.
                </p>
              </div>
            </li>
            <li>
              <span>03</span><div>
                <h3>Review what the capture supports</h3><p>
                  A static reconstruction lets you explore a scene from
                  different positions. Dynamic capture also records movement
                  over time. Motion, lighting, and camera coverage affect the
                  result; we discuss possible outputs for each session.
                </p>
              </div>
            </li>
          </ol>
          <aside id="omnema" class="omnema" aria-labelledby="omnema-title">
            <h3 id="omnema-title">Omnema / Capture tool</h3>
            <p>
              Our distributed capture application brings available phones
              together to record synchronized video from multiple angles.
            </p>
            <a
              class="text-link"
              href="https://capture.rememberingpresence.com/auto">Open Omnema</a
            >
          </aside>
        </div>
      </section>

      <section class="founding section-pad" aria-labelledby="founding-title">
        <p class="section-index">Founding Captures</p>
        <div class="founding-copy">
          <h2 id="founding-title">Early sessions in Connecticut.</h2>
          <p>
            We are selecting a small number of scenes for experimental capture
            sessions. A room, a gathering, a performance, or an object can be a
            starting point.
          </p>
          <p>
            Sessions are free or low-cost while we develop the process. Each is
            planned individually, with scope and possible results discussed
            beforehand. We ask participants to share feedback.
          </p>
        </div>
      </section>

      <section
        id="apply"
        class="apply section-pad"
        aria-labelledby="apply-title"
      >
        <div class="apply-intro">
          <p class="section-index">Applications</p>
          <h2 id="apply-title">Tell us about<br />your scene.</h2>
          <p>
            Describe what you would like to capture and where in or near
            Connecticut it would take place.
          </p>
          <p class="small-copy">
            Selected applicants will hear directly from the founder to discuss
            timing, privacy, practical limits, and what the session could
            produce.
          </p>
        </div>
        <ApplicationForm />
      </section>
      <aside id="memory-dome" class="future-note">
        <p class="section-index">A future studio</p>
        <p>
          <strong>The Memory Dome.</strong> A dedicated studio with cameras arranged
          around its subjects is a longer-term idea. It is not currently available
          for sessions.
        </p>
      </aside>
    </main>
    <footer>
      <a class="wordmark" href="#top">Remembering Presence</a>
      <p>
        An experimental spatial-memory project<br />by Aleatory Time Capture.
      </p>
      <p class="footer-meta">
        Connecticut<br /><a href="https://aleatory.ai">Aleatory.ai</a> · <a
          href="/privacy/">Privacy</a
        >
      </p>
    </footer>
  </div>
</BaseLayout>
