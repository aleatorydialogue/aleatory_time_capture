---
import ApplicationForm from "../components/ApplicationForm.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import scene from "../../public/splat-viewer/scene.foundry.json";
const sceneMB = Math.ceil(
  (scene.model_bytes + scene.static_model_bytes) / 1000000,
);
---

<BaseLayout>
  <div id="top" class="page-shell">
    <SiteHeader />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Experimental spatial capture</p>
          <h1 id="hero-title">aleatory <em>Time Capture</em></h1>
          <p class="product-line">Remembering Presence</p>
          <p class="hero-lede">
            Real moments, reconstructed in space. We use multiple cameras to
            create explorable records of people, places, and moments.
          </p>
          <div class="hero-actions">
            <a class="button button-light" href="#apply"
              >Apply for a Founding Capture <span aria-hidden="true">↘</span></a
            >
            <a class="text-link" href="#what-it-is"
              >How it works <span aria-hidden="true">↓</span></a
            >
          </div>
          <p class="hero-caption">
            A small experimental program, beginning in Connecticut.
          </p>
        </div>

        <figure class="hero-film">
          <video
            data-hero-video
            controls
            loop
            muted
            playsinline
            preload="metadata"
            poster="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74-poster.jpg"
            aria-describedby="hero-film-caption"
          >
            <source
              src="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74.mp4"
              type="video/mp4"
            />
            Your browser does not support embedded video. You can
            <a href="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74.mp4"
              >watch the capture study directly</a
            >.
          </video>
          <figcaption id="hero-film-caption">
            <span>Capture study · 00:39</span>
            <a href="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74.mp4"
              >Watch the film directly</a
            >
          </figcaption>
        </figure>
      </section>

      <script is:inline>
        const heroVideo = document.querySelector("[data-hero-video]");
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

        if (heroVideo instanceof HTMLVideoElement && !reducedMotion.matches) {
          heroVideo.play().catch(() => {
            // The poster and native play control remain available if blocked.
          });
        }
      </script>

      <section
        id="what-it-is"
        class="manifesto section-pad"
        aria-labelledby="manifesto-title"
      >
        <p class="section-index">01 / The idea</p>
        <div>
          <h2 id="manifesto-title">A scene you can move through.</h2>
          <p>
            A spatial reconstruction combines recordings from different camera
            positions. You can look around the captured scene and choose your
            own point of view.
          </p>
        </div>
      </section>

      <section
        id="spatial-example"
        class="spatial-example section-pad"
        aria-labelledby="example-title"
      >
        <div class="example-heading">
          <p class="section-index">Interactive experiment</p>
          <h2 id="example-title">Move through a captured scene.</h2>
          <p>
            Drag to change your point of view. This experiment combines a static
            room reconstruction with animated captured subjects.
          </p>
          <p class="example-note">
            The scene downloads about {sceneMB} MB plus viewer code when opened. Loading
            and playback depend on your connection and device. Dynamic capture is
            still experimental, and results vary by scene.
          </p>
          <a class="text-link" href="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74.mp4"
            >Watch the film if the viewer cannot run</a
          >
        </div>
        <div class="splat-stage" data-splat-stage>
          <div class="splat-placeholder">
            <span class="splat-orbit splat-orbit-one" aria-hidden="true"></span>
            <span class="splat-orbit splat-orbit-two" aria-hidden="true"></span>
            <span class="splat-point" aria-hidden="true"></span>
            <button class="button button-light" type="button" data-load-splat>
              Load interactive scene <span aria-hidden="true">↗</span>
            </button>
            <p>Click to load · approximately {sceneMB} MB</p>
          </div>
          <noscript>
            <p class="splat-noscript">
              JavaScript is required for the interactive viewer. You can
              <a href="https://github.com/aleatorydialogue/aleatory_time_capture/releases/download/homepage-film-20261105/opal-73dff5a411cb4d74.mp4"
                >watch the capture film</a
              >.
            </p>
          </noscript>
        </div>
      </section>

      <script is:inline>
        const stage = document.querySelector("[data-splat-stage]");
        const loadButton = stage?.querySelector("[data-load-splat]");

        loadButton?.addEventListener("click", () => {
          const frame = document.createElement("iframe");
          frame.src = "/splat-viewer/index.html?v=9d0f45a-fsp";
          frame.title = "Interactive Spatial Memory with a captured moment";
          frame.allow = "fullscreen; xr-spatial-tracking";
          frame.setAttribute("allowfullscreen", "");
          stage.replaceChildren(frame);
          frame.focus();
        });
      </script>

      <section
        id="how-it-works"
        class="process section-pad"
        aria-labelledby="process-title"
      >
        <div class="process-heading">
          <p class="section-index">02 / The process</p>
          <h2 id="process-title">How we capture.</h2>
        </div>
        <ol class="steps">
          <li>
            <span>01</span>
            <div>
              <h3>Choose a scene</h3><p>
                Tell us about the people, place, performance, or object you
                would like to capture.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Capture from many views</h3><p>
                We arrange multiple cameras around the scene and guide a capture
                suited to the subject and setting.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Reconstruct the scene</h3><p>
                The views are combined into a spatial scene using Gaussian
                splatting and an evolving reconstruction workflow.
              </p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <h3>Review the result</h3><p>
                We review what the recordings support and discuss possible
                outputs. These may include a static scene or, where the capture
                supports motion, volumetric video.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section
        id="omnema"
        class="omnema section-pad"
        aria-labelledby="omnema-title"
      >
        <div>
          <p class="section-index">Our capture application</p>
          <h2 id="omnema-title">Omnema</h2>
        </div>
        <div class="omnema-copy">
          <p>
            Omnema brings available phones together to record synchronized video
            from multiple angles.
          </p>
          <p>
            We use it to collect different views of the same scene for
            reconstruction.
          </p>
          <a
            class="button button-dark"
            href="https://capture.rememberingpresence.com/auto"
            >Open Omnema <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>

      <section class="founding section-pad" aria-labelledby="founding-title">
        <div class="founding-card">
          <p class="eyebrow">Connecticut · Founding Captures</p>
          <h2 id="founding-title">Early captures in Connecticut.</h2>
          <p>
            We are selecting a small number of scenes for experimental capture
            sessions. Sessions are free or low-cost while we develop the
            process. We discuss the scope and possible results individually.
          </p>
          <ul>
            <li>For people in or near Connecticut</li>
            <li>Designed individually around each scene</li>
            <li>Results depend on the scene and conditions</li>
            <li>Feedback is part of the experience</li>
          </ul>
          <a class="button button-dark" href="#apply"
            >Tell us about your scene <span aria-hidden="true">↘</span></a
          >
        </div>
        <aside id="memory-dome" class="future-note">
          <span class="future-orb" aria-hidden="true"></span>
          <p class="section-index">A future studio</p>
          <h3>The Memory Dome</h3>
          <p>
            A future portrait studio with cameras arranged around its subjects.
            The Memory Dome is a longer-term concept and is not currently
            available for sessions.
          </p>
          <span class="status-pill">Future vision</span>
        </aside>
      </section>

      <section
        id="apply"
        class="apply section-pad"
        aria-labelledby="apply-title"
      >
        <div class="apply-intro">
          <p class="section-index">03 / Applications</p>
          <h2 id="apply-title">Tell us about your scene.</h2>
          <p>
            Describe what you would like to capture and where in or near
            Connecticut it would take place.
          </p>
          <p class="small-copy">
            Selected applicants will hear directly from the founder to discuss
            timing, privacy, practical limits, and what the session could
            produce.
          </p>
        </div>
        <ApplicationForm />
      </section>
    </main>

    <footer>
      <a class="wordmark" href="#top"
        ><span class="wordmark-mark" aria-hidden="true"></span><span
          >aleatory <i>Time Capture</i></span
        ></a
      >
      <p>Preserving meaningful pieces of reality.</p>
      <p class="footer-meta">
        An experimental project by <span class="brand-name">aleatory</span> · Connecticut
        · <a href="/privacy/">Privacy</a>
      </p>
    </footer>
  </div>
</BaseLayout>
