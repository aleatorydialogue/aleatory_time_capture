---
interface Props {
  tagline?: boolean;
  compact?: boolean;
}
const { tagline = true, compact = false } = Astro.props;
---

<a
  class:list={["brand-lockup", { compact }]}
  href="/#top"
  aria-label={tagline
    ? "Aleatory Time Capture — Preserving Human Presence, home"
    : "Aleatory Time Capture, home"}
>
  <svg
    viewBox={compact
      ? "0 0 1100 310"
      : tagline
        ? "0 0 1100 500"
        : "0 0 1100 400"}
    aria-hidden="true"
    focusable="false"
  >
    <circle
      cx="123"
      cy={compact ? 89 : 130}
      r={compact ? 42 : 56}
      fill="none"
      stroke="var(--palette-white)"
      stroke-width="4"></circle>
    <circle
      cx={compact ? 161 : 174}
      cy={compact ? 72 : 107}
      r={compact ? 12 : 16}
      fill="var(--palette-blue)"></circle>
    <text
      class="lockup-name"
      x="620"
      y={compact ? 135 : 192}
      text-anchor="middle">Aleatory</text
    >
    <text
      class="lockup-subtitle"
      x="550"
      y={compact ? 194 : 288}
      text-anchor="middle">TIME CAPTURE</text
    >
    <g transform={compact ? "translate(310 222)" : "translate(310 358)"}>
      <rect width="100" height="17" fill="var(--palette-blue)"></rect>
      <rect x="100" width="226" height="17" fill="var(--palette-green)"></rect>
      <rect x="326" width="77" height="17" fill="var(--palette-purple)"></rect>
      <rect x="403" width="77" height="17" fill="var(--palette-yellow)"></rect>
    </g>
    {
      tagline && (
        <text
          class="lockup-mission"
          x="550"
          y={compact ? 294 : 465}
          text-anchor="middle"
        >
          Preserving Human Presence
        </text>
      )
    }
  </svg>
</a>

<style>
  @font-face {
    font-family: "Aleatory Display";
    src: url("/fonts/DejaVuSerif.ttf") format("truetype");
    font-display: swap;
  }
  @font-face {
    font-family: "Aleatory Sans";
    src: url("/fonts/DejaVuSans.ttf") format("truetype");
    font-display: swap;
  }
  .brand-lockup {
    display: block;
    width: min(100%, 760px);
    margin-inline: auto;
    text-decoration: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .lockup-name {
    font-family: "Aleatory Display", serif;
    font-size: 190px;
    font-weight: 400;
    fill: var(--palette-white);
  }
  .lockup-subtitle {
    font-family: "Aleatory Sans", sans-serif;
    font-size: 42px;
    letter-spacing: 12px;
    font-weight: 400;
    fill: var(--palette-blue);
  }
  .lockup-mission {
    font-family: "Aleatory Sans", sans-serif;
    font-size: 46px;
    font-weight: 400;
    fill: var(--palette-gray);
  }
  .compact {
    width: min(100%, 680px);
  }
  .compact .lockup-name {
    font-size: 140px;
  }
  .compact .lockup-subtitle {
    font-size: 36px;
  }
  .compact .lockup-mission {
    font-size: 40px;
  }
</style>
